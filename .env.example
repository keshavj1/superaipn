# Base URL of the chatbot backend (server/index.js).
# Local development: the Express server defaults to port 5000.
# Production: set this in your Vercel project settings to the deployed backend URL,
# e.g. https://superaip-api.onrender.com
# Left blank on purpose. Vite inlines this AT BUILD TIME, so shipping a
# localhost default here means anyone who copies this file to .env and runs a
# production build bakes http://localhost:5000 into the bundle — which fails for
# every visitor and is blocked as mixed content on HTTPS.
# Local development: leave blank; Chatbot.jsx falls back to localhost:5000 in DEV.
VITE_API_URL=
